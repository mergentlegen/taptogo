{
  "name": "taptogo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "playwright test -c playwright.supabase.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:size": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "cf:secrets": "node --env-file=.env.local scripts/cf-secrets.mjs",
    "cf:build:docker": "node scripts/cf-build.mjs",
    "cf:preview": "node scripts/cf-build.mjs && wrangler dev",
    "cf:deploy": "node scripts/cf-build.mjs && wrangler deploy",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "jszip": "^3.10.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.14.0"
}
