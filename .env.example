# Copy to .env.local and adjust. Every variable is optional in development:
# `pnpm dev` works without a .env.local file at all.

# Where data comes from. Only "mock" exists today (in-memory demo data).
# Will become "supabase" after docs/SUPABASE_MIGRATION.md is done.
DATA_SOURCE=mock

# Public base URL of the app. Used to build card links (/t/{code}) and links in emails.
APP_URL=http://localhost:3000

# HMAC key that signs the session cookie. At least 32 characters.
# REQUIRED in production — the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Fallback IANA time zone for organizations without their own setting.
DEFAULT_TIMEZONE=Asia/Almaty
