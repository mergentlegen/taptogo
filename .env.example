# Copy to .env.local and adjust. In development every variable is optional:
# `pnpm dev` works without a .env.local file at all (mock data).

# ── App ─────────────────────────────────────────────────────

# Where data comes from:
#   mock     in-memory demo data (default; demo accounts, nothing is stored)
#   supabase the real database and sign-in; needs the three SUPABASE_* values below.
#            Create the first administrator with: pnpm create-admin you@example.com "Name"
DATA_SOURCE=mock

# Public base URL of the app. Used to build card links (/t/{code}) and links in messages.
# Production: the Cloudflare address, e.g. https://taptogo.<account>.workers.dev
APP_URL=http://localhost:3000

# HMAC key that signs the session cookie of the MOCK sign-in. At least 32 characters.
# REQUIRED in production with DATA_SOURCE=mock; not used with supabase (Supabase Auth has its own sessions).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Fallback IANA time zone for organizations without their own setting.
DEFAULT_TIMEZONE=Asia/Almaty

# ── Supabase (used when DATA_SOURCE=supabase) ───────────────

# Project URL: Supabase → Project Settings → API.
SUPABASE_URL=

# Publishable key (sb_publishable_…, formerly "anon"). Safe to expose; access is limited by RLS.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…, formerly "service_role"). SERVER ONLY, bypasses RLS.
# Never commit it, never prefix it with NEXT_PUBLIC_, never paste it into chats.
SUPABASE_SECRET_KEY=

# ── Background jobs ─────────────────────────────────────────

# Bearer token that protects cron routes. Generate it like SESSION_SECRET.
CRON_SECRET=

# ── 2GIS API (hidden while features.twogisApi is false; leave empty) ─

TWOGIS_API_KEY=
